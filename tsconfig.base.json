/* 应用、测试和构建工具共用的 TypeScript 检查规则。 */
{
  /* 设置语言支持、模块解析和代码检查方式。 */
  "compilerOptions": {
    /* 缓存上次检查结果，加快后续检查。 */
    "incremental": true,
    /* 以 ES2020 作为语言目标；浏览器兼容范围还需由 Vite 构建配置决定。 */
    "target": "ES2020",
    /* 提供 ES2020 标准 API 的类型提示，不会给运行环境补齐这些 API。 */
    "lib": ["ES2020"],
    /* 将每个源码文件视为独立模块，避免顶层变量意外变成全局变量。 */
    "moduleDetection": "force",
    /* 使用现代 ES 模块语法，由 Vite 处理模块打包。 */
    "module": "ESNext",

    /* 按打包工具的方式查找模块，支持省略导入路径中的文件扩展名。 */
    "moduleResolution": "bundler",

    /* 开启严格类型检查，例如检查空值和无法推断类型的参数。 */
    "strict": true,
    /* 防止 switch 中有代码的分支意外继续执行下一个分支。 */
    "noFallthroughCasesInSwitch": true,
    /* 提示未使用的局部变量和导入。 */
    "noUnusedLocals": true,
    /* 提示未使用的函数参数；以 _ 开头的参数可以保留。 */
    "noUnusedParameters": true,
    /* 只检查类型，不输出 JavaScript 或声明文件；实际打包交给 Vite。 */
    "noEmit": true,
    /*
     * 只当作类型使用的内容，要用 import type / export type。
     * 例如：import type { User } from './types'。
     * 普通 import 会保留到运行时，不会因为只用作类型就自动删除。
     */
    "verbatimModuleSyntax": true,
    /*
     * 只允许去掉类型标注后就能运行的写法。
     * 例如：const count: number = 0 可以，去掉 : number 后仍是正常代码。
     * enum Status { Ready, Done } 不可以，因为它需要转换成额外的 JavaScript 代码。
     */
    "erasableSyntaxOnly": true,
    /* 跳过声明文件内部的类型检查以提速，业务源码仍正常检查。 */
    "skipLibCheck": true,
    /*
     * 不接收任何导出内容的导入，也要检查能否找到模块。
     * 例如：import './setup'，如果找不到 setup 模块就报错。
     * 避免把路径写成 './setpu' 后，类型检查却没有提醒。
     */
    "noUncheckedSideEffectImports": true
  }
}
